<Window x:Class="VAL.App.ControlCentreOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:VAL.App.UI"
        mc:Ignorable="d"
        Title="VAL - Control Centre"
        Width="36"
        Height="36"
        MinWidth="34"
        MinHeight="34"
        MaxWidth="64"
        MaxHeight="64"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False">
    <Window.Resources>
        <Style x:Key="LauncherToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#F5020A14" />
            <Setter Property="Foreground" Value="#B0EBF5FF" />
            <Setter Property="BorderBrush" Value="#2E78B4F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Placement" Value="Right" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <ui:BezelChrome Radius="22" Rim="3.2" IsPanel="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </ui:BezelChrome>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
          Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}">
        <Button x:Name="LauncherButton"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"
                AutomationProperties.Name="Control Centre"
                AutomationProperties.AcceleratorKey="F6"
                AutomationProperties.HelpText="Press F6 from the page to focus this icon, then Enter or Space to open Control Centre. Tab or Escape returns to the page. Alt+arrow keys move the icon."
                Style="{DynamicResource VAL.CircularButton}"
                Cursor="Hand"
                BorderThickness="0"
                BorderBrush="Transparent"
                Background="Transparent"
                Foreground="{DynamicResource VAL.TextForegroundBrush}"
                Padding="0"
                Click="LauncherButton_Click"
                PreviewMouseLeftButtonDown="LauncherButton_PreviewMouseLeftButtonDown"
                PreviewMouseMove="LauncherButton_PreviewMouseMove"
                PreviewMouseLeftButtonUp="LauncherButton_PreviewMouseLeftButtonUp"
                LostMouseCapture="LauncherButton_LostMouseCapture"
                PreviewKeyDown="LauncherButton_PreviewKeyDown"
                FocusVisualStyle="{x:Null}">
            <Button.ToolTip>
                <ToolTip Style="{StaticResource LauncherToolTipStyle}">
                    <TextBlock Foreground="#B0EBF5FF"
                               FontSize="12"
                               TextWrapping="Wrap"
                               MaxWidth="320"
                               LineHeight="15">
                        <Run Text="Control Centre" />
                        <LineBreak />
                        <Run Text="F6 to focus. Enter or Space to open." />
                        <LineBreak />
                        <Run Text="Drag to move. Alt+arrow keys also move." />
                        <LineBreak />
                        <Run Text="Reset placement: Ctrl+Alt+Shift+L" />
                    </TextBlock>
                </ToolTip>
            </Button.ToolTip>
        </Button>

        <Grid x:Name="LauncherGlyphLayer"
              IsHitTestVisible="False"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Image x:Name="LauncherImage"
                   Width="30"
                   Height="30"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"
                   RenderOptions.BitmapScalingMode="Fant" />
            <TextBlock x:Name="LauncherFallbackText"
                       Text="CC"
                       Foreground="{Binding ElementName=LauncherButton, Path=Foreground}"
                       FontSize="9.5"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Visible" />
        </Grid>

        <Border x:Name="ResizeHandle"
                Width="10"
                Height="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,1,1"
                CornerRadius="2"
                Background="#80A8C8"
                Cursor="SizeNWSE"
                Visibility="Collapsed"
                PreviewMouseLeftButtonDown="ResizeHandle_PreviewMouseLeftButtonDown"
                PreviewMouseMove="ResizeHandle_PreviewMouseMove"
                PreviewMouseLeftButtonUp="ResizeHandle_PreviewMouseLeftButtonUp" />
    </Grid>
</Window>
