<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:VAL.App.UI">
    <SolidColorBrush x:Key="VAL.WindowBackgroundBrush" Color="#F5020A14" />
    <SolidColorBrush x:Key="VAL.TextForegroundBrush" Color="#DCE4ED" />
    <SolidColorBrush x:Key="VAL.MutedForegroundBrush" Color="#A8B4C2" />
    <SolidColorBrush x:Key="VAL.AccentBrush" Color="#79B8FF" />
    <SolidColorBrush x:Key="VAL.SoftBorderBrush" Color="#66768B" />
    <SolidColorBrush x:Key="VAL.TextBoxBackgroundBrush" Color="#0A111B" />
    <FontFamily x:Key="VAL.DockFontFamily">Inter, Helvetica Neue, Arial, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="VAL.SoftGlassForegroundBrush" Color="#DCE4ED" />
    <LinearGradientBrush x:Key="VAL.RecoveryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#152130" Offset="0" />
        <GradientStop Color="#0A111B" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="VAL.FocusVisual" TargetType="Control">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Control">
                <Rectangle Margin="-2" RadiusX="22" RadiusY="22"
                           Stroke="{StaticResource VAL.AccentBrush}" StrokeThickness="2" />
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="VAL.ButtonTemplate" TargetType="Button">
        <ui:BezelChrome x:Name="RecoveryChrome" Padding="{TemplateBinding Padding}"
                        IsHovered="{TemplateBinding IsMouseOver}" IsPressed="{TemplateBinding IsPressed}"
                        SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </ui:BezelChrome>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="RecoveryChrome" Property="IsFocusVisible" Value="True" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="RecoveryChrome" Property="RenderTransform">
                    <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RecoveryChrome" Property="IsHovered" Value="False" />
                <Setter TargetName="RecoveryChrome" Property="IsPressed" Value="False" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource VAL.DockFontFamily}" />
        <Setter Property="Background" Value="{StaticResource VAL.RecoveryButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VAL.TextForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VAL.SoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource VAL.ButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.44" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="VAL.NativeRecoveryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource VAL.SoftGlassForegroundBrush}" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style x:Key="VAL.ToolWindowSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    <Style x:Key="VAL.ToolWindowPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    <Style x:Key="VAL.CircularButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource VAL.TextForegroundBrush}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
                <ui:BezelChrome x:Name="ToggleChrome" Rim="2.6" Padding="{TemplateBinding Padding}"
                                IsHovered="{TemplateBinding IsMouseOver}" IsPressed="{TemplateBinding IsPressed}"
                                IsFocusVisible="{TemplateBinding IsKeyboardFocused}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </ui:BezelChrome>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ToggleChrome" Property="IsSelected" Value="True" />
                        <Setter Property="Foreground" Value="#E5EFFF" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.44" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="VALWindowTheme" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource VAL.WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VAL.TextForegroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Cycle" />
    </Style>
    <Style x:Key="VAL.ToolWindowOuterBorder" TargetType="ui:BezelChrome">
        <Setter Property="Margin" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Radius" Value="22" />
        <Setter Property="Rim" Value="3.2" />
        <Setter Property="IsPanel" Value="True" />
    </Style>
    <Style x:Key="VAL.ToolWindowHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource VAL.TextForegroundBrush}" /></Style>
    <ControlTemplate x:Key="VAL.TextInputTemplate" TargetType="TextBoxBase">
        <ui:BezelChrome Radius="10" Padding="{TemplateBinding Padding}"
                        IsFocusVisible="{TemplateBinding IsKeyboardFocusWithin}">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
        </ui:BezelChrome>
    </ControlTemplate>
    <Style x:Key="VAL.TextInput" TargetType="TextBoxBase">
        <Setter Property="Background" Value="{StaticResource VAL.TextBoxBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VAL.TextForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource VAL.AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource VAL.TextInputTemplate}" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource VAL.TextInput}" />
    <Style TargetType="RichTextBox" BasedOn="{StaticResource VAL.TextInput}" />
    <Style x:Key="VAL.ToolWindowReportViewer" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="Foreground" Value="{StaticResource VAL.TextForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource VAL.WindowBackgroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource VAL.FocusVisual}" />
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource VAL.TextForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VAL.SoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource VAL.SoftBorderBrush}" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="Height" Value="1" />
    </Style>
</ResourceDictionary>
